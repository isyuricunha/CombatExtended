<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Convert the nitrogen mortar shell to CE ammo and register it with the 81mm
	     mortar ammoset, following the vanilla Deadlife shell handling. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Shell_AENitrogen"]</xpath>
		<value>
			<ThingDef Class="CombatExtended.AmmoDef" ParentName="81mmMortarShellBase">
				<defName>Shell_AENitrogen</defName>
				<label>81mm mortar shell (Nitrogen)</label>
				<description>A shell filled with destabilized ice crystal, for spilling nitrogen around that freezing and slowing down surrounding targets when detonated. It causes cryogenic bonding of mechanical components, effectively disrupting the functionality of different machinery and temporarily disabling electrical devices. Explodes when damaged.</description>
				<possessionCount>1</possessionCount>
				<graphicData>
					<texPath>Things/Item/Resource/Shell/Shell_AENitrogen</texPath>
					<graphicClass>Graphic_StackCount</graphicClass>
				</graphicData>
				<statBases>
					<Mass>5.27</Mass>
					<Bulk>8.17</Bulk>
				</statBases>
				<ammoClass>AENitrogen</ammoClass>
				<detonateProjectile>Bullet_Shell_AENitrogen</detonateProjectile>
				<costList>
					<AE_IceCrystalDestabilized>1</AE_IceCrystalDestabilized>
					<Bioferrite>15</Bioferrite>
				</costList>
				<costListForDifficulty>
					<difficultyVar>classicMortars</difficultyVar>
					<costList>
						<AE_IceCrystalDestabilized>1</AE_IceCrystalDestabilized>
						<Bioferrite>25</Bioferrite>
					</costList>
				</costListForDifficulty>
				<recipeMaker>
					<researchPrerequisite>AEIceCrystalDestabilized</researchPrerequisite>
					<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
					<effectWorking>Cook</effectWorking>
					<soundWorking>Recipe_Machining</soundWorking>
					<workAmount>800</workAmount>
					<targetCountAdjustment>5</targetCountAdjustment>
					<workSkill>Crafting</workSkill>
					<recipeUsers>
						<li>BioferriteShaper</li>
					</recipeUsers>
					<skillRequirements>
						<Crafting>4</Crafting>
					</skillRequirements>
					<displayPriority>1300</displayPriority>
				</recipeMaker>
				<genericMarketSellable>false</genericMarketSellable>
				<tradeability>Sellable</tradeability>
				<modExtensions>
					<li Class="CombatExtended.GenericLabelExtension">
						<genericLabel>mortar shell (Nitrogen)</genericLabel>
					</li>
				</modExtensions>
			</ThingDef>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Bullet_Shell_AENitrogen"]</xpath>
		<value>
			<ThingDef ParentName="Base81mmMortarShell">
				<defName>Bullet_Shell_AENitrogen</defName>
				<label>81mm mortar shell (Nitrogen)</label>
				<graphicData>
					<texPath>Things/Projectile/AEShellNitrogen</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<projectile Class="CombatExtended.ProjectilePropertiesCE">
					<damageDef>AENitrogen</damageDef>
					<damageAmountBase>25</damageAmountBase>
					<armorPenetrationBlunt>8</armorPenetrationBlunt>
					<explosionRadius>5.9</explosionRadius>
					<flyOverhead>true</flyOverhead>
					<soundExplode>Explosion_EMP</soundExplode>
					<dangerFactor>1.5</dangerFactor>
				</projectile>
				<modExtensions>
					<li Class="CombatExtended.GenericLabelExtension">
						<genericLabel>mortar shell (Nitrogen)</genericLabel>
					</li>
				</modExtensions>
			</ThingDef>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_81mmMortarShell"]/ammoTypes</xpath>
		<value>
			<Shell_AENitrogen>Bullet_Shell_AENitrogen</Shell_AENitrogen>
		</value>
	</Operation>

</Patch>
