<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Freezing damage is resisted by thermal insulation. AENitrogenPlayer inherits
	     from AENitrogen (Name="AENitrogenBase") and needs no separate patch.
	     Armor penetration is carried by ToolCE and ProjectilePropertiesCE on every
	     delivery path, so defaultArmorPenetration is not patched. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/DamageDef[defName="AENitrogen"]</xpath>
		<value>
			<armorCategory>Heat</armorCategory>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/DamageDef[defName="AEFreezing"]/armorCategory</xpath>
		<value>
			<armorCategory>Heat</armorCategory>
		</value>
	</Operation>

</Patch>
