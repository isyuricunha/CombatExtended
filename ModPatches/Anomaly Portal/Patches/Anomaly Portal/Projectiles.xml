<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Anomaly Portal</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>

				<!-- ========== AP_Projectile_TeleportSpike ========== -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="AP_Projectile_TeleportSpike"]/thingClass</xpath>
					<value>
						<thingClass>CombatExtended.Compatibility.AnomalyPortalCompat.BulletCE_Teleport</thingClass>
					</value>
				</li>

				<!-- AP_Damage_Teleport's worker does not extend DamageWorker_AddInjury, so use RangedStab to land HP damage -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="AP_Projectile_TeleportSpike"]/projectile</xpath>
					<value>
						<projectile Class="CombatExtended.ProjectilePropertiesCE">
							<damageDef>RangedStab</damageDef>
							<damageAmountBase>12</damageAmountBase>
							<speed>55</speed>
							<armorPenetrationSharp>0.10</armorPenetrationSharp>
							<armorPenetrationBlunt>0.05</armorPenetrationBlunt>
							<suppressionFactor>0.5</suppressionFactor>
							<dangerFactor>1.0</dangerFactor>
						</projectile>
					</value>
				</li>

			</operations>
		</match>
	</Operation>

</Patch>
