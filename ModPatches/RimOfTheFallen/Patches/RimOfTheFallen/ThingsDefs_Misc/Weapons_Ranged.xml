<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Sentinels Crossbow -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_SentinelsCrossbow"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>7</power>
					<cooldownTime>1.60</cooldownTime>
					<armorPenetrationBlunt>0.65</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

	<!-- Mini Hwacha -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_MiniHwacha"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>6</power>
					<cooldownTime>1.45</cooldownTime>
					<armorPenetrationBlunt>0.65</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>RofF_SentinelsCrossbow</defName>
		<statBases>
			<Bulk>6</Bulk>
			<SwayFactor>1.15</SwayFactor>
			<ShotSpread>0.22</ShotSpread>
			<SightsEfficiency>1</SightsEfficiency>
			<RangedWeapon_Cooldown>0.70</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Projectile_CrossbowBolt_Steel</defaultProjectile>
			<warmupTime>0.85</warmupTime>
			<range>20</range>
			<soundCast>Bow_Recurve</soundCast>
		</Properties>
		<AmmoUser>
			<magazineSize>2</magazineSize>
			<reloadTime>4.20</reloadTime>
			<ammoSet>AmmoSet_CrossbowBolt</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_XBow</li>
			<li>CE_OneHandedWeapon</li>
		</weaponTags>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>RofF_MiniHwacha</defName>
		<statBases>
			<Bulk>7</Bulk>
			<SwayFactor>1.50</SwayFactor>
			<ShotSpread>0.45</ShotSpread>
			<SightsEfficiency>0.85</SightsEfficiency>
			<RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Projectile_CrossbowBolt_Steel</defaultProjectile>
			<warmupTime>0.45</warmupTime>
			<range>18</range>
			<soundCast>Bow_Recurve</soundCast>
		</Properties>
		<AmmoUser>
			<magazineSize>4</magazineSize>
			<reloadTime>6.20</reloadTime>
			<ammoSet>AmmoSet_CrossbowBolt</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiAimMode>Snapshot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_XBow</li>
		</weaponTags>
	</Operation>

</Patch>
