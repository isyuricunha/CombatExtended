	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_HallowedKnightHelmet"]/apparel/bodyPartGroups</xpath>
		<value>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="RofF_HallowedKnightHelmet"]</xpath>
		<value>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>0.85</ArmorRating_Sharp>
						<parts><li>Nose</li></parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.85</ArmorRating_Blunt>
						<parts><li>Nose</li></parts>
					</li>
				</stats>
			</li>
		</value>
	</Operation>


	<!-- ========================= -->
	<!-- Sovereign Protector Helmet-->
	<!-- ========================= -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_SovereignProtectorHelmet"]/statBases</xpath>
		<value>
			<statBases>
				<WorkToMake>9500</WorkToMake>
				<MaxHitPoints>240</MaxHitPoints>
				<Mass>3.1</Mass>
				<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
				<ArmorRating_Blunt>0.56</ArmorRating_Blunt>
				<ArmorRating_Heat>0.07</ArmorRating_Heat>
				<Insulation_Cold>2</Insulation_Cold>
				<Insulation_Heat>1</Insulation_Heat>
				<EquipDelay>6</EquipDelay>
				<Bulk>5.0</Bulk>
				<WornBulk>1</WornBulk>
				<StuffEffectMultiplierArmor>4.20</StuffEffectMultiplierArmor>
			</statBases>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_SovereignProtectorHelmet"]/costStuffCount</xpath>
		<value><costStuffCount>85</costStuffCount></value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_SovereignProtectorHelmet"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<AimingAccuracy>-0.04</AimingAccuracy>
				<MeleeHitChance>-0.05</MeleeHitChance>
				<Suppressability>-0.10</Suppressability>
				<PainShockThreshold>0.08</PainShockThreshold>
				<SocialImpact>0.10</SocialImpact>
