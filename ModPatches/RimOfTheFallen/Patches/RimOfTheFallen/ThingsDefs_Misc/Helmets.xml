						<ArmorRating_Sharp>1.15</ArmorRating_Sharp>
						<parts><li>Eye</li><li>Nose</li></parts>
					</li>
					<li>
						<ArmorRating_Blunt>1.15</ArmorRating_Blunt>
						<parts><li>Eye</li><li>Nose</li></parts>
					</li>
				</stats>
			</li>
		</value>
