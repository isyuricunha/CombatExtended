			<statBases>
				<WorkToMake>6000</WorkToMake>
				<MaxHitPoints>180</MaxHitPoints>
				<Mass>2.6</Mass>
				<ArmorRating_Sharp>0.30</ArmorRating_Sharp>
				<ArmorRating_Blunt>0.42</ArmorRating_Blunt>
				<ArmorRating_Heat>0.06</ArmorRating_Heat>
				<Insulation_Cold>2</Insulation_Cold>
				<Insulation_Heat>1</Insulation_Heat>
				<EquipDelay>5</EquipDelay>
				<Bulk>4.4</Bulk>
				<WornBulk>1</WornBulk>
				<StuffEffectMultiplierArmor>3.50</StuffEffectMultiplierArmor>
			</statBases>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_HallowedKnightHelmet"]/costStuffCount</xpath>
		<value><costStuffCount>60</costStuffCount></value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_HallowedKnightHelmet"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<AimingAccuracy>-0.06</AimingAccuracy>
				<MeleeHitChance>-0.04</MeleeHitChance>
				<Suppressability>-0.05</Suppressability>
				<PainShockThreshold>0.05</PainShockThreshold>
