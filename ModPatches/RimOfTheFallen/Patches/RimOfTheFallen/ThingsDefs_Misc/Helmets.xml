<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ========================= -->
	<!-- Infantry Helmet           -->
	<!-- ========================= -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_InfantryHelmet"]/statBases</xpath>
		<value>
			<statBases>
				<WorkToMake>3500</WorkToMake>
				<MaxHitPoints>130</MaxHitPoints>
				<Mass>1.9</Mass>
				<ArmorRating_Sharp>0.20</ArmorRating_Sharp>
				<ArmorRating_Blunt>0.30</ArmorRating_Blunt>
				<ArmorRating_Heat>0.05</ArmorRating_Heat>
				<Insulation_Cold>2</Insulation_Cold>
				<Insulation_Heat>1</Insulation_Heat>
				<EquipDelay>4</EquipDelay>
				<Bulk>4</Bulk>
				<WornBulk>1</WornBulk>
				<StuffEffectMultiplierArmor>2.40</StuffEffectMultiplierArmor>
			</statBases>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_InfantryHelmet"]/costStuffCount</xpath>
		<value><costStuffCount>45</costStuffCount></value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_InfantryHelmet"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<AimingAccuracy>-0.03</AimingAccuracy>
				<Suppressability>-0.04</Suppressability>
			</equippedStatOffsets>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_InfantryHelmet"]/apparel/bodyPartGroups</xpath>
		<value>
			<bodyPartGroups>
				<li>UpperHead</li>
				<li>Neck</li>
			</bodyPartGroups>
		</value>
	</Operation>


	<!-- ========================= -->
	<!-- Hallowed Knight Helmet    -->
