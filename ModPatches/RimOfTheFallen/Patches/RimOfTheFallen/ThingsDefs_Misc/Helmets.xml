	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RofF_InfantryHelmet"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
			<WornBulk>1</WornBulk>
			<StuffEffectMultiplierArmor>2.40</StuffEffectMultiplierArmor>
		</value>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RofF_InfantryHelmet"]/equippedStatOffsets</xpath>
