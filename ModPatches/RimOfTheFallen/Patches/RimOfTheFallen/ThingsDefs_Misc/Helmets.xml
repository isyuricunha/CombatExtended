	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_SovereignProtectorHelmet"]/apparel/bodyPartGroups</xpath>
		<value>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
		</value>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RofF_SovereignProtectorHelmet"]/apparel/layers/li[text()="StrappedHead"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="RofF_SovereignProtectorHelmet"]/apparel/layers</xpath>
			<order>Prepend</order>
			<value>
				<li>StrappedHead</li>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="RofF_SovereignProtectorHelmet"]</xpath>
		<value>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>1.00</ArmorRating_Sharp>
						<parts><li>Eye</li><li>Nose</li></parts>
					</li>
					<li>
						<ArmorRating_Blunt>1.00</ArmorRating_Blunt>
						<parts><li>Eye</li><li>Nose</li></parts>
					</li>
				</stats>
			</li>
		</value>
	</Operation>


	<!-- ========================= -->
	<!-- Paladin Helmet            -->
	<!-- ========================= -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/costList</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/costList</xpath>
		</match>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/stuffCategories</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]</xpath>
			<value>
				<stuffCategories>
					<li>Metallic</li>
				</stuffCategories>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/stuffCategories</xpath>
		<value>
			<stuffCategories>
				<li>Metallic</li>
			</stuffCategories>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/statBases</xpath>
		<value>
			<statBases>
				<WorkToMake>14000</WorkToMake>
				<MaxHitPoints>300</MaxHitPoints>
				<Mass>3.4</Mass>
				<ArmorRating_Sharp>0.52</ArmorRating_Sharp>
				<ArmorRating_Blunt>0.72</ArmorRating_Blunt>
				<ArmorRating_Heat>0.08</ArmorRating_Heat>
				<Insulation_Cold>2</Insulation_Cold>
				<Insulation_Heat>1</Insulation_Heat>
				<EquipDelay>7</EquipDelay>
				<Bulk>5.4</Bulk>
				<WornBulk>1.1</WornBulk>
				<StuffEffectMultiplierArmor>4.85</StuffEffectMultiplierArmor>
			</statBases>
		</value>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/costStuffCount</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]</xpath>
			<value>
				<costStuffCount>105</costStuffCount>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/costStuffCount</xpath>
		<value><costStuffCount>105</costStuffCount></value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RofF_PaladinHelmet"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<AimingAccuracy>-0.02</AimingAccuracy>
				<MeleeHitChance>-0.02</MeleeHitChance>
				<Suppressability>-0.12</Suppressability>
