		<xpath>Defs/ThingDef[@Name="VQE_BaseDrone"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>2</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="VQE_BaseDrone"]/statBases/ArmorRating_Heat</xpath>
		<value>
			<ArmorRating_Heat>0.00</ArmorRating_Heat>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="VQE_BaseDrone"]/statBases</xpath>
		<value>
			<CarryWeight>50</CarryWeight>
			<CarryBulk>20</CarryBulk>
			<MeleeDodgeChance>0.1</MeleeDodgeChance>
			<MeleeCritChance>0.04</MeleeCritChance>
			<MeleeParryChance>0.04</MeleeParryChance>
