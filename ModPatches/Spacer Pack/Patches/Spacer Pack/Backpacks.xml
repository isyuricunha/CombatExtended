<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ThingDef Editing -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="dvd_BackpackBase"]/apparel/bodyPartGroups</xpath>
		<value>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="dvd_BackpackBase"]/apparel/layers</xpath>
		<value>
			<layers>
				<li>Backpack</li>
			</layers>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="dvd_BackpackBase"]/thingCategories</xpath>
		<value>
			<thingCategories>
				<li>Loadout</li>
			</thingCategories>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="BackpackBase"]/tradeTags</xpath>
		<value>
			<li>Clothing</li>
		</value>
	</Operation>

	<!-- Harvest Pack -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_WovenHarvestpack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>30</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_WovenHarvestpack"]/statBases/Mass</xpath>
		<value>
			<Mass>4</Mass>
			<Bulk>8</Bulk>
		</value>
	</Operation>

	<!-- Psychic Foilpack -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_PsychicFoilpack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>40</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_PsychicFoilpack"]/statBases/Mass</xpath>
		<value>
			<Mass>6</Mass>
			<Bulk>8</Bulk>
		</value>
	</Operation>

	<!-- Hybrid Aeropack -->

	<Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Royalty">
		<xpath>Defs/ThingDef[defName="dvd_HybridAeropack"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<CarryBulk>40</CarryBulk>
			</equippedStatOffsets>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Royalty">
		<xpath>Defs/ThingDef[defName="dvd_HybridAeropack"]/statBases/Mass</xpath>
		<value>
			<Mass>6</Mass>
			<Bulk>8</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Royalty">
		<xpath>Defs/ThingDef[defName="dvd_HybridAeropack"]/statBases/JumpRange</xpath>
		<value>
			<JumpRange>40</JumpRange>
		</value>
	</Operation>

	<!-- Devourer Grubpack -->

	<Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Anomaly">
		<xpath>Defs/ThingDef[defName="dvd_NeotenicGrubpack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>70</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Anomaly">
		<xpath>Defs/ThingDef[defName="dvd_NeotenicGrubpack"]/equippedStatOffsets/MoveSpeed</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Anomaly">
		<xpath>Defs/ThingDef[defName="dvd_NeotenicGrubpack"]/statBases/Mass</xpath>
		<value>
			<Mass>6</Mass>
			<Bulk>8</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Anomaly">
		<xpath>Defs/ThingDef[defName="dvd_NeotenicGrubpack"]/verbs</xpath>
		<value>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<label>splash acid</label>
					<verbClass>CombatExtended.Verb_LaunchProjectileStaticCE</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<onlyManualCast>True</onlyManualCast>
					<warmupTime>1.5</warmupTime>
					<range>35</range>
					<minRange>5</minRange>
					<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
					<soundCast>SpitterSpit</soundCast>
					<soundCastTail>GunTail_Medium</soundCastTail>
					<muzzleFlashScale>14</muzzleFlashScale>
					<drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
					<defaultProjectile>dvd_NeotenicGrubpack_spit_CE</defaultProjectile>
					<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
				</li>
			</verbs>
		</value>
	</Operation>

	<!-- Spacer Pack -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_spacerpack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>80</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="dvd_spacerpack"]/equippedStatOffsets/MoveSpeed</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_spacerpack"]/statBases/Mass</xpath>
		<value>
			<Mass>4</Mass>
			<Bulk>5</Bulk>
		</value>
	</Operation>

	<!-- Mechtech Exopack (with grey goo Grenade built in)-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_MechanicalExopack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>80</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="dvd_MechanicalExopack"]/equippedStatOffsets/MoveSpeed</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_MechanicalExopack"]/statBases/Mass</xpath>
		<value>
			<Mass>4</Mass>
			<Bulk>5</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_MechanicalExopack"]/verbs</xpath>
		<value>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<label>launch ripper rack</label>
					<verbClass>CombatExtended.Verb_LaunchProjectileStaticCE</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<onlyManualCast>True</onlyManualCast>
					<warmupTime>1.0</warmupTime>
					<range>21</range>
					<minRange>6</minRange>
					<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
					<soundCast>InfernoCannon_Fire</soundCast>
					<soundCastTail>GunTail_Medium</soundCastTail>
					<muzzleFlashScale>14</muzzleFlashScale>
					<drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
					<defaultProjectile>dvd_Projectile_RipperRack_CE</defaultProjectile>
					<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
				</li>
			</verbs>
		</value>
	</Operation>

	<!-- Get rid of the unused vanilla projectile to suppress an error, idk what error is now adding one for acid just to be safe-->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="dvd_ProjectileRipperBlast"]</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Anomaly">
		<xpath>Defs/ThingDef[defName="dvd_ProjectileGrubGlob"]</xpath>
	</Operation>

	<!-- Med Pack -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_GlittertechMedpack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>60</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="dvd_GlittertechMedpack"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
		</value>
	</Operation>

	<!-- Voidsent Pack -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_VoidsentPulsepack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>80</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="dvd_VoidsentPulsepack"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_VoidsentPulsepack"]/comps/li[@Class="VEF.Apparels.CompProperties_ShieldBubble"]/EnergyShieldRechargeRate</xpath>
		<value>
			<EnergyShieldRechargeRate>0.075</EnergyShieldRechargeRate>
		</value>
	</Operation>

	<!-- Archotech Skippack -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_ArchotechSkippack"]/equippedStatOffsets/VEF_MassCarryCapacity</xpath>
		<value>
			<CarryBulk>120</CarryBulk>
			<CarryWeight>100</CarryWeight>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_ArchotechSkippack"]/statBases/Mass</xpath>
		<value>
			<Mass>6</Mass>
			<Bulk>6</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AbilityDef[defName="dvd_InvokeSkipbolt"]/verbProperties/range</xpath>
		<value>
			<range>25</range>
		</value>
	</Operation>

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="dvd_ProjectileSkipbolt"]</xpath>
		<attribute>ParentName</attribute>
		<value>BaseExplosiveBullet</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_ProjectileSkipbolt"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="dvd_ProjectileSkipbolt"]/projectile</xpath>
		<value>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<damageDef>dvd_Skipwave</damageDef>
				<speed>60</speed>
				<damageAmountBase>30</damageAmountBase>
				<armorPenetrationSharp>120</armorPenetrationSharp>
				<armorPenetrationBlunt>120</armorPenetrationBlunt>
				<explosionRadius>2.5</explosionRadius>
				<explosionEffect>dvd_SkipImpact</explosionEffect>
				<doExplosionVFX>False</doExplosionVFX>
			</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="dvd_ProjectileSkipbolt"]/comps/li[@Class="CompProperties_ProjectileEffecter"]</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="dvd_ProjectileSkipbolt"]</xpath>
		<value>
			<comps>
				<li Class="CombatExtended.CompProperties_ProjectileFleck">
					<FleckDatas>
						<li>
							<fleck>dvd_SkipParticle</fleck>
							<emissionsPerTick>0.16</emissionsPerTick>
							<rotation>0</rotation>
							<scale>0.25~0.50</scale>
							<flecksPerEmission>1</flecksPerEmission>
						</li>
					</FleckDatas>
				</li>
			</comps>
		</value>
	</Operation>

</Patch>